<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/story_item_width"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <FrameLayout
        android:layout_width="94dp"
        android:layout_height="94dp">

        <View
            android:id="@+id/ring"
            android:layout_width="94dp"
            android:layout_height="94dp"
            android:background="@drawable/bg_story_ring" />

        <View
            android:layout_width="87dp"
            android:layout_height="87dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_story_gap" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/avatar"
            android:layout_width="81dp"
            android:layout_height="81dp"
            android:layout_gravity="center"
            android:contentDescription="@string/cd_avatar"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/CircleImage" />

        <FrameLayout
            android:id="@+id/addBadge"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="bottom|end"
            android:background="@drawable/bg_add_badge"
            android:visibility="gone">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:contentDescription="@string/cd_icon"
                android:src="@drawable/ic_add" />

        </FrameLayout>

    </FrameLayout>

    <TextView
        android:id="@+id/name"
        android:layout_width="106dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:ellipsize="end"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/ig_white"
        android:textSize="12sp" />

</LinearLayout>
